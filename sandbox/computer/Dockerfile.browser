FROM debian@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 DISPLAY=:1
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl dbus-x11 fonts-dejavu fonts-noto-cjk git jq less nodejs npm openbox procps \
      python3 python3-pip python3-websockify ripgrep scrot tar tigervnc-standalone-server \
      tigervnc-tools unzip xdotool chromium \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1000 agent && useradd -m -u 1000 -g 1000 -s /bin/bash agent \
    && groupadd -g 1001 vnc && useradd -M -u 1001 -g 1001 -s /usr/sbin/nologin vnc \
    && mkdir -p /home/agent/workspace /home/agent/Desktop /run/vnc \
    && chown -R agent:agent /home/agent && chown vnc:vnc /run/vnc

COPY hive-screen hive-session-browser hive-shot /usr/local/bin/
RUN chmod 755 /usr/local/bin/hive-screen /usr/local/bin/hive-session-browser /usr/local/bin/hive-shot

USER agent
WORKDIR /home/agent/workspace
CMD ["sleep", "infinity"]
